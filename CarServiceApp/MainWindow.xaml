<Window x:Class="CarServiceApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CarServiceApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="25"/>
        </Style>
    </Window.Resources>
    
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <Label Content="Автосервис" FontSize="22" FontWeight="Bold"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Left" Width="150">
            <Button Content="Приём" Click="Button_Click"/>
            <Button Content="Услуги" Click="Button_Click_1"/>
            <Button Content="Машинки" Click="Button_Click_2"/>
        </StackPanel>
        <Frame x:Name="MainFrame"/>
    </DockPanel>
</Window>
